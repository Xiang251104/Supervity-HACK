# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev

# ------------------------------------------------------------
# SUPERVITY AUTO  (the agent layer — never commit real values)
# ------------------------------------------------------------
# Generate the workflow API key at https://auto.supervity.ai/u/api-keys
# Sent as: Authorization: Bearer <key>  +  x-source: external  +  x-active-org
SUPERVITY_API_KEY=
SUPERVITY_ACTIVE_ORG=
SUPERVITY_BASE_URL=https://auto.supervity.ai
SUPERVITY_ORCHESTRATOR_WORKFLOW_ID=
SUPERVITY_TIMEOUT_SECONDS=300

# ------------------------------------------------------------
# SUPABASE  (AP system of record — read by the Auto Operators)
# ------------------------------------------------------------
# The backend only needs read access for Data Manager health checks and Insights.
# The Operators reach Supabase through Auto's native connector, not through here.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Outlook/Slack activity stays healthy for this many hours (must be positive)
INTEGRATION_HEALTH_MAX_AGE_HOURS=24

# ------------------------------------------------------------
# SLACK  (exception alerts — bank details are always redacted)
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=
